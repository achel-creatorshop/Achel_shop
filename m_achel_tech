<!DOCTYPE html>
<html lang="rw">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>M ACHEL TECH LTD - Electronics & Technology Solutions</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap');
    body { font-family: 'Inter', sans-serif; }
    .cart-drawer { transition: transform 0.3s ease-in-out; }
  </style>
</head>
<body class="bg-gray-50 text-gray-800 flex flex-col min-h-screen">

  <!-- Header / Navigation -->
  <header class="bg-slate-900 text-white sticky top-0 z-40 shadow-xl">
    <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="flex items-center justify-between w-full md:w-auto">
        <h1 class="text-2xl font-extrabold tracking-wider text-blue-400 flex items-center gap-2">
          <i class="fa-solid fa-microchip text-3xl"></i> M ACHEL TECH LTD
        </h1>
        <button id="cart-btn-mobile" onclick="toggleCart()" class="md:hidden relative text-gray-300 hover:text-white">
          <i class="fa-solid fa-cart-shopping text-2xl"></i>
          <span id="cart-count-mobile" class="absolute -top-2 -right-2 bg-blue-500 text-white text-xs font-bold px-2 py-0.5 rounded-full">0</span>
        </button>
      </div>

      <!-- Search Bar -->
      <div class="relative w-full md:w-1/3">
        <input type="text" id="search-input" onkeyup="filterProducts()" placeholder="Shakisha mudasobwa, telefone, headphones..." class="w-full pl-10 pr-4 py-2 rounded-lg text-gray-900 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm">
        <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-gray-400"></i>
      </div>

      <!-- Social Share Buttons & Cart Desktop -->
      <div class="flex items-center gap-3">
        <!-- Share options -->
        <div class="hidden lg:flex items-center gap-2 bg-slate-800 px-3 py-1.5 rounded-lg border border-slate-700">
          <span class="text-xs text-gray-400 font-medium">Sangiza:</span>
          <button onclick="shareWhatsApp()" title="Share on WhatsApp" class="text-green-400 hover:text-green-300 text-lg transition"><i class="fa-brands fa-whatsapp"></i></button>
          <button onclick="shareFacebook()" title="Share on Facebook" class="text-blue-400 hover:text-blue-300 text-lg transition"><i class="fa-brands fa-facebook"></i></button>
          <button onclick="shareTwitter()" title="Share on X (Twitter)" class="text-sky-400 hover:text-sky-300 text-lg transition"><i class="fa-brands fa-x-twitter"></i></button>
          <button onclick="shareInstagram()" title="Copy Link for Instagram" class="text-pink-400 hover:text-pink-300 text-lg transition"><i class="fa-brands fa-instagram"></i></button>
        </div>

        <button onclick="toggleCart()" class="hidden md:flex items-center gap-2 bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-lg font-medium transition shadow-lg">
          <i class="fa-solid fa-cart-shopping"></i>
          <span>Icyangombwa</span>
          <span id="cart-count" class="bg-white text-blue-600 font-bold text-xs px-2 py-0.5 rounded-full">0</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Banner -->
  <section class="bg-gradient-to-r from-slate-900 via-blue-900 to-indigo-900 text-white py-14 px-4 text-center relative overflow-hidden">
    <div class="max-w-3xl mx-auto relative z-10">
      <span class="bg-blue-600/30 border border-blue-400/30 text-blue-300 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-widest inline-block mb-3">Official Electronics Store</span>
      <h2 class="text-3xl md:text-5xl font-black tracking-tight mb-4">M ACHEL TECH LTD</h2>
      <p class="text-blue-100 text-base md:text-lg font-light leading-relaxed mb-6">Dutanga ibikoresho bya Electronics bigezweho birimo Mudasobwa, Telefone, Isaha z'ubwenge, Headphones, n'ibindi mu biciro byiza mu Rwanda.</p>
      
      <!-- Mobile Share Buttons -->
      <div class="flex lg:hidden justify-center items-center gap-4 bg-slate-800/80 backdrop-blur-md p-3 rounded-xl max-w-xs mx-auto border border-slate-700">
        <span class="text-xs text-gray-300">Sangiza:</span>
        <button onclick="shareWhatsApp()" class="text-green-400 text-xl"><i class="fa-brands fa-whatsapp"></i></button>
        <button onclick="shareFacebook()" class="text-blue-400 text-xl"><i class="fa-brands fa-facebook"></i></button>
        <button onclick="shareTwitter()" class="text-sky-400 text-xl"><i class="fa-brands fa-x-twitter"></i></button>
        <button onclick="shareInstagram()" class="text-pink-400 text-xl"><i class="fa-brands fa-instagram"></i></button>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-4 py-10 flex-grow w-full">
    
    <!-- Category Filter -->
    <div class="flex flex-wrap justify-center gap-2 mb-10">
      <button onclick="filterCategory(this, 'All')" class="cat-btn active bg-blue-600 text-white px-5 py-2.5 rounded-full font-semibold text-sm transition shadow-md hover:bg-blue-700">Byose</button>
      <button onclick="filterCategory(this, 'Laptops')" class="cat-btn bg-white text-gray-700 hover:bg-gray-100 border border-gray-200 px-5 py-2.5 rounded-full font-semibold text-sm transition">Mudasobwa (Laptops)</button>
      <button onclick="filterCategory(this, 'Phones')" class="cat-btn bg-white text-gray-700 hover:bg-gray-100 border border-gray-200 px-5 py-2.5 rounded-full font-semibold text-sm transition">Telefone (Smartphones)</button>
      <button onclick="filterCategory(this, 'Audio')" class="cat-btn bg-white text-gray-700 hover:bg-gray-100 border border-gray-200 px-5 py-2.5 rounded-full font-semibold text-sm transition">Audio & Accessories</button>
      <button onclick="filterCategory(this, 'Wearables')" class="cat-btn bg-white text-gray-700 hover:bg-gray-100 border border-gray-200 px-5 py-2.5 rounded-full font-semibold text-sm transition">Smartwatches</button>
    </div>

    <!-- Products Grid -->
    <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      <!-- Dynamically generated via JS -->
    </div>
  </main>

  <!-- Shopping Cart Drawer -->
  <div id="cart-drawer" class="cart-drawer fixed top-0 right-0 h-full w-full sm:w-96 bg-white shadow-2xl z-50 transform translate-x-full flex flex-col">
    <div class="bg-slate-900 text-white p-4 flex justify-between items-center">
      <h3 class="text-lg font-bold flex items-center gap-2"><i class="fa-solid fa-basket-shopping text-blue-400"></i> Icyangombwa cy'Ibyo Waguze</h3>
      <button onclick="toggleCart()" class="text-gray-400 hover:text-white text-2xl font-bold">&times;</button>
    </div>

    <div id="cart-items" class="p-4 flex-grow overflow-y-auto space-y-4">
      <p class="text-gray-500 text-center py-12">Nta kintu kirazamo.</p>
    </div>

    <div class="p-4 border-t bg-gray-50">
      <div class="flex justify-between items-center text-lg font-extrabold mb-4">
        <span>Ayo Kwishyura:</span>
        <span id="cart-total" class="text-blue-600">0 RWF</span>
      </div>
      <button onclick="checkout()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 rounded-xl shadow-lg transition flex items-center justify-center gap-2">
        <i class="fa-solid fa-money-bill-wave"></i> Emeza no Kwishyura
      </button>
    </div>
  </div>

  <!-- Footer -->
  <footer class="bg-slate-900 text-gray-400 py-10 border-t border-slate-800 mt-auto">
    <div class="max-w-7xl mx-auto px-4 grid grid-cols-1 md:grid-cols-3 gap-8 text-center md:text-left">
      <div>
        <h3 class="text-white text-lg font-bold mb-2">M ACHEL TECH LTD</h3>
        <p class="text-sm">M ACHEL TECH LTD ni duka ryawe rya mbere ry'ibikoresho bya Electronics nyabyo mu Rwanda.</p>
      </div>
      <div>
        <h4 class="text-white font-semibold mb-2">Ibice by'Urubuga</h4>
        <ul class="text-sm space-y-1">
          <li><a href="#" class="hover:text-white">Mudasobwa (Laptops)</a></li>
          <li><a href="#" class="hover:text-white">Telefone (Smartphones)</a></li>
          <li><a href="#" class="hover:text-white">Smartwatches</a></li>
        </ul>
      </div>
      <div>
        <h4 class="text-white font-semibold mb-2">Tuvugishe & Sangiza</h4>
        <p class="text-sm mb-3">Kigali, Rwanda | +250 788 000 000</p>
        <div class="flex justify-center md:justify-start gap-4 text-xl">
          <button onclick="shareWhatsApp()" class="text-green-400 hover:text-white"><i class="fa-brands fa-whatsapp"></i></button>
          <button onclick="shareFacebook()" class="text-blue-400 hover:text-white"><i class="fa-brands fa-facebook"></i></button>
          <button onclick="shareTwitter()" class="text-sky-400 hover:text-white"><i class="fa-brands fa-x-twitter"></i></button>
          <button onclick="shareInstagram()" class="text-pink-400 hover:text-white"><i class="fa-brands fa-instagram"></i></button>
        </div>
      </div>
    </div>
    <div class="text-center text-xs text-gray-500 mt-8 pt-4 border-t border-slate-800">
      &copy; 2026 M ACHEL TECH LTD. All rights reserved.
    </div>
  </footer>

  <!-- JavaScript Application Logic -->
  <script>
    // Real Electronics Products Data with images from Unsplash
    const products = [
      { id: 1, name: "MacBook Pro 16\" M3", category: "Laptops", price: 2800000, img: "https://images.unsplash.com/photo-1517336714731-489689fd1ca8?w=600&auto=format&fit=crop" },
      { id: 2, name: "iPhone 15 Pro Max", category: "Phones", price: 1650000, img: "https://images.unsplash.com/photo-1592750475338-74b7b21085ab?w=600&auto=format&fit=crop" },
      { id: 3, name: "Sony WH-1000XM5 Headphones", category: "Audio", price: 420000, img: "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=600&auto=format&fit=crop" },
      { id: 4, name: "Apple Watch Series 9", category: "Wearables", price: 550000, img: "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=600&auto=format&fit=crop" },
      { id: 5, name: "Dell XPS 15 OLED", category: "Laptops", price: 1950000, img: "https://images.unsplash.com/photo-1593642632823-8f785ba67e45?w=600&auto=format&fit=crop" },
      { id: 6, name: "Samsung Galaxy S24 Ultra", category: "Phones", price: 1500000, img: "https://images.unsplash.com/photo-1610945265064-0e34e5519bbf?w=600&auto=format&fit=crop" },
      { id: 7, name: "AirPods Pro (2nd Gen)", category: "Audio", price: 320000, img: "https://images.unsplash.com/photo-1600294037681-c80b4cb5b434?w=600&auto=format&fit=crop" },
      { id: 8, name: "Samsung Galaxy Watch 6", category: "Wearables", price: 380000, img: "https://images.unsplash.com/photo-1508685096489-7aacd43bd3b1?w=600&auto=format&fit=crop" }
    ];

    let cart = [];
    let activeCategory = 'All';

    // Render Products
    function renderProducts() {
      const grid = document.getElementById('product-grid');
      const searchVal = document.getElementById('search-input').value.toLowerCase();

      const filtered = products.filter(p => {
        const matchesCat = activeCategory === 'All' || p.category === activeCategory;
        const matchesSearch = p.name.toLowerCase().includes(searchVal);
        return matchesCat && matchesSearch;
      });

      if (filtered.length === 0) {
        grid.innerHTML = `<div class="col-span-full text-center py-16 text-gray-500 font-medium">Nta gikoresho kibonetse gihuza n'ibyo ushakisha.</div>`;
        return;
      }

      grid.innerHTML = filtered.map(product => `
        <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 overflow-hidden flex flex-col justify-between group">
          <div class="overflow-hidden bg-gray-100 relative">
            <img src="${product.img}" alt="${product.name}" class="h-52 w-full object-cover group-hover:scale-105 transition duration-500">
            <span class="absolute top-3 left-3 bg-slate-900/80 backdrop-blur-md text-white text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider">${product.category}</span>
          </div>
          <div class="p-5 flex-grow flex flex-col justify-between">
            <div>
              <h3 class="text-base font-bold text-gray-800 group-hover:text-blue-600 transition">${product.name}</h3>
            </div>
            <div class="mt-4 flex justify-between items-center">
              <div>
                <span class="text-xs text-gray-400 block">Igiciro</span>
                <span class="text-lg font-black text-slate-900">${product.price.toLocaleString()} RWF</span>
              </div>
              <button onclick="addToCart(${product.id})" class="bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-xl transition shadow-md hover:shadow-lg flex items-center justify-center">
                <i class="fa-solid fa-cart-plus text-base"></i>
              </button>
            </div>
          </div>
        </div>
      `).join('');
    }

    // Category Filter Function
    function filterCategory(btn, cat) {
      activeCategory = cat;
      document.querySelectorAll('.cat-btn').forEach(b => {
        b.classList.remove('bg-blue-600', 'text-white', 'shadow-md');
        b.classList.add('bg-white', 'text-gray-700');
      });
      btn.classList.add('bg-blue-600', 'text-white', 'shadow-md');
      btn.classList.remove('bg-white', 'text-gray-700');
      renderProducts();
    }

    function filterProducts() {
      renderProducts();
    }

    // Cart Operations
    function addToCart(productId) {
      const product = products.find(p => p.id === productId);
      const cartItem = cart.find(item => item.id === productId);

      if (cartItem) {
        cartItem.qty += 1;
      } else {
        cart.push({ ...product, qty: 1 });
      }

      updateCartUI();
    }

    function removeFromCart(productId) {
      cart = cart.filter(item => item.id !== productId);
      updateCartUI();
    }

    function changeQty(productId, delta) {
      const item = cart.find(i => i.id === productId);
      if (item) {
        item.qty += delta;
        if (item.qty <= 0) {
          removeFromCart(productId);
          return;
        }
      }
      updateCartUI();
    }

    function updateCartUI() {
      const countMobile = document.getElementById('cart-count-mobile');
      const countDesktop = document.getElementById('cart-count');
      const cartItems = document.getElementById('cart-items');
      const cartTotal = document.getElementById('cart-total');

      const totalQty = cart.reduce((sum, item) => sum + item.qty, 0);
      const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

      countMobile.innerText = totalQty;
      countDesktop.innerText = totalQty;
      cartTotal.innerText = totalPrice.toLocaleString() + ' RWF';

      if (cart.length === 0) {
        cartItems.innerHTML = `<p class="text-gray-500 text-center py-12">Nta kintu kirazamo.</p>`;
        return;
      }

      cartItems.innerHTML = cart.map(item => `
        <div class="flex items-center justify-between bg-gray-50 p-3 rounded-xl border border-gray-100">
          <div class="flex items-center gap-3">
            <img src="${item.img}" class="w-12 h-12 rounded-lg object-cover">
            <div>
              <h4 class="font-bold text-xs text-gray-800">${item.name}</h4>
              <p class="text-xs text-blue-600 font-bold mt-0.5">${item.price.toLocaleString()} RWF</p>
              <div class="flex items-center gap-2 mt-1.5">
                <button onclick="changeQty(${item.id}, -1)" class="bg-gray-200 hover:bg-gray-300 w-5 h-5 rounded flex items-center justify-center font-bold text-xs">-</button>
                <span class="text-xs font-bold">${item.qty}</span>
                <button onclick="changeQty(${item.id}, 1)" class="bg-gray-200 hover:bg-gray-300 w-5 h-5 rounded flex items-center justify-center font-bold text-xs">+</button>
              </div>
            </div>
          </div>
          <button onclick="removeFromCart(${item.id})" class="text-red-400 hover:text-red-600 p-2">
            <i class="fa-solid fa-trash-can"></i>
          </button>
        </div>
      `).join('');
    }

    function toggleCart() {
      const drawer = document.getElementById('cart-drawer');
      drawer.classList.toggle('translate-x-full');
    }

    function checkout() {
      if (cart.length === 0) {
        alert("Icyangombwa cyanyu ntikirimwo ibikoresho!");
        return;
      }
      alert("Murakoze kugura muri M ACHEL TECH LTD!\nIgiteranyo ni: " + document.getElementById('cart-total').innerText + "\nKwishyura koresha MoMo Pay (*182*8*1*Code#).");
      cart = [];
      updateCartUI();
      toggleCart();
    }

    // Social Sharing Functions
    const currentUrl = encodeURIComponent(window.location.href);
    const shareText = encodeURIComponent("Sura urubuga rwa M ACHEL TECH LTD uhawe ibikoresho bya Electronics bigezweho!");

    function shareWhatsApp() {
      window.open(`https://api.whatsapp.com/send?text=${shareText}%20${currentUrl}`, '_blank');
    }

    function shareFacebook() {
      window.open(`https://www.facebook.com/sharer/sharer.php?u=${currentUrl}`, '_blank');
    }

    function shareTwitter() {
      window.open(`https://twitter.com/intent/tweet?text=${shareText}&url=${currentUrl}`, '_blank');
    }

    function shareInstagram() {
      navigator.clipboard.writeText(window.location.href).then(() => {
        alert("Link y'urubuga M ACHEL TECH LTD yakoporowe! Urashobora kuyishyira muri Instagram Bio cyangwa Story.");
      });
    }

    // Initial Load
    renderProducts();
  </script>
</body>
</html>
